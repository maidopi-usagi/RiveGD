+void RawTextInput::composition(const std::string& value,
+                               uint32_t start,
+                               uint32_t length)
+{
+    if (value.empty())
+    {
+        cancelComposition();
+        return;
+    }
+    if (!m_composing)
+    {
+        m_compositionOriginal = m_text;
+        m_compositionCursor = m_cursor;
+        m_composing = true;
+    }
+    std::vector<Unichar> preview;
+    const uint8_t* ptr = reinterpret_cast<const uint8_t*>(value.c_str());
+    while (*ptr) preview.push_back(UTF::NextUTF8(&ptr));
+    m_text = m_compositionOriginal;
+    if (m_text.empty()) m_text.push_back(zeroWidthSpace);
+    const size_t limit = m_text.size() - 1;
+    const size_t first = std::min(size_t(m_compositionCursor.first().codePointIndex()), limit);
+    const size_t last = std::min(size_t(m_compositionCursor.last().codePointIndex()), limit);
+    m_text.erase(m_text.begin() + first, m_text.begin() + last);
+    m_text.insert(m_text.begin() + first, preview.begin(), preview.end());
+    const size_t anchor = std::min(size_t(start), preview.size());
+    const size_t extent = anchor + std::min(size_t(length), preview.size() - anchor);
+    m_cursor = Cursor(CursorPosition(uint32_t(first + anchor)), CursorPosition(uint32_t(first + extent)));
+    m_idealCursorX = -1.0f;
+    flag(Flags::shapeDirty | Flags::measureDirty | Flags::selectionDirty);
+}
+
+void RawTextInput::cancelComposition()
+{
+    if (!m_composing) return;
+    m_text = std::move(m_compositionOriginal);
+    m_cursor = m_compositionCursor;
+    m_composing = false;
+    m_idealCursorX = -1.0f;
+    flag(Flags::shapeDirty | Flags::measureDirty | Flags::selectionDirty);
+}
+
+std::string RawTextInput::committedText() const
+{
+    if (!m_composing) return text();
+    return m_compositionOriginal.size() <= 1 ? std::string() :
+        encodeCodePoints(Span<const Unichar>(m_compositionOriginal.data(), m_compositionOriginal.size() - 1));
+}
