#!/usr/bin/env python
import os
import urllib.request
import zipfile
import io
import shutil
import re
import tempfile
import hashlib

Import("env")

# Clone the environment to avoid polluting the main environment with Rive-specific flags
rive_env = env.Clone()

# rive-runtime is in a subdirectory of the current directory (third-party)
rive_dir = os.path.join(Dir(".").abspath, "rive-runtime")
deps_dir = os.path.join(rive_dir, "dependencies")

# Keep the recorder compatible with Rive revisions that expose
# Renderer::modulateOpacity(), without relying on a global Git safe-directory.
renderer_header = os.path.join(rive_dir, "include", "rive", "renderer.hpp")
try:
    with open(renderer_header, "r", encoding="utf-8") as header:
        if "virtual void modulateOpacity(float opacity)" in header.read():
            rive_env.Append(CPPDEFINES=["RIVE_GODOT_HAS_MODULATE_OPACITY"])
except OSError as exc:
    raise RuntimeError(f"Could not inspect Rive renderer API: {renderer_header}") from exc

# --- Install Dependencies (HarfBuzz & SheenBidi) ---
# Version the upgraded dependency caches so older local builds remain recoverable.
harfbuzz_dir = os.path.join(deps_dir, "harfbuzz-08d34675f64b")
sheenbidi_dir = os.path.join(deps_dir, "sheenbidi")
yoga_dir = os.path.join(deps_dir, "yoga-dd288d29db01")
miniaudio_dir = os.path.join(deps_dir, "miniaudio")
libpng_dir = os.path.join(deps_dir, "libpng-1f1a50134680")
zlib_dir = os.path.join(deps_dir, "zlib")
libjpeg_dir = os.path.join(deps_dir, "libjpeg")
libwebp_dir = os.path.join(deps_dir, "libwebp")

def install_dependency(name, url, sha256, target_dir, retries=4):
    source_marker = os.path.join(target_dir, ".rivegd-source.sha256")
    if os.path.exists(target_dir):
        if os.path.isfile(source_marker):
            with open(source_marker, "r", encoding="ascii") as marker:
                installed_sha256 = marker.read().strip()
            if installed_sha256 == sha256:
                return
            raise RuntimeError(
                f"Existing {name} dependency marker does not match the pinned archive. "
                f"Move {target_dir} aside and rebuild."
            )
        # Preserve dependencies created by older revisions. They cannot be
        # authenticated retroactively, so do not invent a marker for them.
        print(
            f"RIVE: WARNING: Using unverified legacy {name} dependency at {target_dir}. "
            "Move it aside and rebuild to install the pinned, verified archive."
        )
        return

    if not url.startswith("https://codeload.github.com/"):
        raise RuntimeError(f"Refusing non-codeload dependency URL for {name}: {url}")
    target_parent = os.path.dirname(target_dir)
    os.makedirs(target_parent, exist_ok=True)

    def safe_extract(archive, destination):
        destination_real = os.path.realpath(destination)
        members = archive.infolist()
        if not members:
            raise ValueError(f"Archive for {name} is empty")
        roots = {member.filename.split("/", 1)[0] for member in members}
        if len(roots) != 1 or "" in roots:
            raise ValueError(f"Archive for {name} does not have one root directory")
        for member in members:
            member_real = os.path.realpath(os.path.join(destination, member.filename))
            if os.path.commonpath((destination_real, member_real)) != destination_real:
                raise ValueError(f"Archive for {name} contains an unsafe path")
        archive.extractall(destination)
        return roots.pop()

    import time
    last_err = None
    for attempt in range(1, retries + 1):
        print(f"RIVE: Downloading {name} from {url} (attempt {attempt}/{retries})...")
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "RiveGD-CI"})
            with urllib.request.urlopen(req, timeout=120) as response:
                data = response.read()
            actual_sha256 = hashlib.sha256(data).hexdigest()
            if actual_sha256 != sha256:
                raise ValueError(
                    f"SHA-256 mismatch for {name}: expected {sha256}, got {actual_sha256}"
                )
            # Keep extraction on the target volume so os.rename remains atomic
            # when Windows TEMP and the checkout are on different drives.
            with tempfile.TemporaryDirectory(prefix="rivegd-dependency-", dir=target_parent) as extract_dir:
                with zipfile.ZipFile(io.BytesIO(data)) as archive:
                    root = safe_extract(archive, extract_dir)
                extracted_path = os.path.join(extract_dir, root)
                os.rename(extracted_path, target_dir)
            with open(source_marker, "w", encoding="ascii", newline="\n") as marker:
                marker.write(sha256 + "\n")
            print(f"RIVE: Installed {name} to {target_dir}")
            return
        except Exception as e:
            last_err = e
            print(f"RIVE: Attempt {attempt} failed for {name}: {e}")
            if attempt < retries:
                backoff = min(2 ** attempt, 30)
                print(f"RIVE: Retrying in {backoff}s...")
                time.sleep(backoff)
    print(f"RIVE: Failed to install {name} after {retries} attempts: {last_err}")
    Exit(1)

install_dependency("HarfBuzz", "https://codeload.github.com/rive-app/harfbuzz/zip/08d34675f64b1ac4880f4f10c9fd474a56dd4399", "895da10ea61d204ce09c1d0bdca487eb580a0739ec25b0f44fa54fddddff1802", harfbuzz_dir)
install_dependency("SheenBidi", "https://codeload.github.com/Tehreer/SheenBidi/zip/adfccc46504b1be37b8894f064121c56c31312f7", "53652cb962dae39bb58b0b9bfb07b7c60b1576631164ac40750b93d6471a26e3", sheenbidi_dir)
install_dependency("Yoga", "https://codeload.github.com/rive-app/yoga/zip/dd288d29db01ba9da03d0c3684c00e6ae74e6e61", "25f1e7edda7b8dfff4dbd847d8306081dc0dbc67eee6912f44d9b5242ae5bbdd", yoga_dir)
install_dependency("Miniaudio", "https://codeload.github.com/rive-app/miniaudio/zip/3a8b070f80e203a35ec763c5118da20805a90d5a", "1fd99f980c9d056c9dcfdee600ddddf3f1a62b955ebcdb422804adcaf7995df8", miniaudio_dir)
install_dependency("LibPNG", "https://codeload.github.com/glennrp/libpng/zip/1f1a501346800e9660d3039a6efbf90b685b5d97", "bcc332dc24968fddda33742ed52316fad3f96f53adaf6724d429152127c4d964", libpng_dir)
install_dependency("ZLib", "https://codeload.github.com/madler/zlib/zip/51b7f2abdade71cd9bb0e7a373ef2610ec6f9daf", "8be92f276c1280aa4f46a878008c7bf295b6ca8da0eb27b41e3666d894f0d32c", zlib_dir)
install_dependency("LibJPEG", "https://codeload.github.com/rive-app/libjpeg/zip/2f995b502f6ea31cb130d93b5661bf468c114e19", "782a72878da3ecfce4619d72f15d1b60d8c38303f0a4bea4cf1391b202236369", libjpeg_dir)
install_dependency("LibWebP", "https://codeload.github.com/webmproject/libwebp/zip/845d5476a866141ba35ac133f856fa62f0b7445f", "1745e44c510c4f4119f154dc3f09c10c3e272b28225b8af32988ff224f3e492e", libwebp_dir)

# --- Preprocess Generated Shaders (Fix C2026) ---
def preprocess_generated_shaders(env, rive_dir):
    # Target directory containing the problematic headers
    generated_shaders_dir = os.path.join(rive_dir, "renderer", "include", "generated", "shaders")
    if not os.path.exists(generated_shaders_dir):
        return

    # Create a temporary directory for the modified headers
    # We use a consistent path in temp to avoid clutter, but ensure it's fresh
    temp_base = os.path.join(tempfile.gettempdir(), "rivegd_shader_fix")
    if os.path.exists(temp_base):
        try:
            shutil.rmtree(temp_base)
        except OSError:
            pass # Might be in use, but we try our best
    
    # We need to preserve the include structure: generated/shaders/...
    # So if we add temp_base to CPPPATH, we need the files to be in temp_base/generated/shaders
    target_dir = os.path.join(temp_base, "generated", "shaders")
    
    # print(f"RIVE: Pre-processing generated shaders to {target_dir} to fix C2026...")
    
    def convert_raw_string_to_hex_array(content):
        # Regex to match: const char name[] = R"delimiter(content)delimiter";
        # We capture the name, the delimiter, and the content.
        # We use re.DOTALL so . matches newlines.
        pattern = r'(?:static\s+)?const\s+char\s+(\w+)\[\]\s*=\s*R"([^"(]*)\((.*?)\)\2";'
        
        def replacer(match):
            name = match.group(1)
            body = match.group(3)
            
            # Convert string to bytes (UTF-8)
            bytes_data = body.encode('utf-8')
            
            # Convert to hex strings
            hex_values = [f"0x{b:02x}" for b in bytes_data]
            hex_values.append("0x00") # Null terminator
            
            # Format with line breaks to be readable/safe
            lines = []
            chunk_size = 16 # 16 bytes per line
            for i in range(0, len(hex_values), chunk_size):
                lines.append(", ".join(hex_values[i:i+chunk_size]))
            
            array_body = ",\n".join(lines)
            
            # Reconstruct as char array initialization
            return f"const char {name}[] = {{\n{array_body}\n}};"

        return re.sub(pattern, replacer, content, flags=re.DOTALL)

    for root, dirs, files in os.walk(generated_shaders_dir):
        rel_path = os.path.relpath(root, generated_shaders_dir)
        dest_root = os.path.join(target_dir, rel_path)
        if not os.path.exists(dest_root):
            os.makedirs(dest_root)
            
        for f in files:
            if f.endswith(".h") or f.endswith(".hpp") or f.endswith(".glsl"):
                src_file = os.path.join(root, f)
                dst_file = os.path.join(dest_root, f)
                
                try:
                    with open(src_file, 'r', encoding='utf-8', errors='ignore') as fin:
                        content = fin.read()
                    
                    # Apply the conversion
                    new_content = convert_raw_string_to_hex_array(content)
                    
                    # If no change (no raw string found), we still write it out 
                    # because we need the file to exist in the include path override.
                    
                    with open(dst_file, 'w', encoding='utf-8') as fout:
                        fout.write(new_content)
                except Exception as e:
                    print(f"Warning: Failed to process {src_file}: {e}")

    # Prepend the temp directory to include paths so modified files are found first
    env.Prepend(CPPPATH=[temp_base])

preprocess_generated_shaders(rive_env, rive_dir)

# --- Generate pnglibconf.h ---
png_config_dir = os.path.join(libpng_dir, "rivegd-config")
pnglibconf_h = os.path.join(png_config_dir, "pnglibconf.h")
if not os.path.exists(pnglibconf_h):
    print("RIVE: Generating pnglibconf.h...")
    os.makedirs(os.path.dirname(pnglibconf_h), exist_ok=True)
    shutil.copy(os.path.join(libpng_dir, "scripts", "pnglibconf.h.prebuilt"), pnglibconf_h)

rive_env.Append(CPPPATH=[
    os.path.join(rive_dir, "include"),
    rive_dir,
    os.path.join(rive_dir, "renderer"),
    os.path.join(rive_dir, "renderer", "src"),
    os.path.join(rive_dir, "renderer", "include"),
    os.path.join(rive_dir, "renderer", "glad", "include"),
    os.path.join(rive_dir, "renderer", "glad"),
    os.path.join(harfbuzz_dir, "src"),
    deps_dir, # For rive_harfbuzz_renames.h
    os.path.join(sheenbidi_dir, "Headers"),
    yoga_dir,
    miniaudio_dir,
    libpng_dir,
    zlib_dir,
    png_config_dir,
    libjpeg_dir,
    libwebp_dir,
    os.path.join(libwebp_dir, "src"),
    os.path.join(rive_dir, "decoders", "include")
])

rive_env.Append(CPPDEFINES=[
    '_RIVE_INTERNAL_', 'WITH_RIVE_TEXT', 'WITH_RIVE_TOOLS',
    'WITH_RIVE_LAYOUT', 'YOGA_EXPORT=',
    'WITH_RIVE_AUDIO', 'MA_NO_RESOURCE_MANAGER',
    'RIVE_PNG', 'RIVE_JPEG', 'RIVE_WEBP', 'RIVE_DECODERS',
    'SB_CONFIG_UNITY'
])
# Desktop GL is not available on Android; Vulkan is used there instead.
if rive_env["platform"] != "android":
    rive_env.Append(CPPDEFINES=['RIVE_DESKTOP_GL'])
else:
    # Required to activate GLES3 headers in gles3.hpp (and related renderer files).
    rive_env.Append(CPPDEFINES=['RIVE_ANDROID'])

# Suppress warnings for third-party dependencies
if rive_env["platform"] != "windows":
    rive_env.Append(CCFLAGS=['-Wno-unused-function', '-Wno-error=unused-function', '-Wno-macro-redefined'])

# Force include unistd.h for zlib on macOS/Android to fix implicit function declaration errors
# (lseek and friends are POSIX; C99/C11 strict mode requires explicit inclusion of <unistd.h>)
if rive_env["platform"] in ["macos", "android"]:
    rive_env.Append(CCFLAGS=['-include', 'unistd.h'])

# Force include rive_harfbuzz_renames.h
if rive_env["platform"] == "windows":
    rive_env.Append(CCFLAGS=['/FIrive_harfbuzz_renames.h'])
    rive_env.Append(CCFLAGS=['/FIrive_yoga_renames.h'])
    rive_env.Append(CCFLAGS=['/FIrive_libjpeg_renames.h'])
    rive_env.Append(CCFLAGS=['/FIrive_png_renames.h'])
else:
    rive_env.Append(CCFLAGS=['-include', 'rive_harfbuzz_renames.h'])
    rive_env.Append(CCFLAGS=['-include', 'rive_yoga_renames.h'])
    rive_env.Append(CCFLAGS=['-include', 'rive_libjpeg_renames.h'])
    rive_env.Append(CCFLAGS=['-include', 'rive_png_renames.h'])

# Platform specific flags
if rive_env["platform"] == "macos":
    rive_env.Append(CCFLAGS=["-fobjc-arc"])
    rive_env.Append(FRAMEWORKS=["Metal", "Foundation", "QuartzCore", "AppKit", "CoreGraphics", "CoreText", "AudioToolbox"])
    rive_env.Append(CPPDEFINES=["RIVE_METAL"])
elif rive_env["platform"] in ["windows", "linux", "android"]:
    rive_env.Append(CPPDEFINES=[
        "RIVE_VULKAN", "RIVE_UPSTREAM_VULKAN_IMPL", "VULKAN_ENABLED",
        "VK_NO_PROTOTYPES", "VMA_STATIC_VULKAN_FUNCTIONS=0",
        "VMA_DYNAMIC_VULKAN_FUNCTIONS=1",
    ])
    # Match upstream: atomic shaders are enabled on desktop, opt-in on Android.
    if rive_env["platform"] != "android":
        rive_env.Append(CPPDEFINES=["WITH_VULKAN_ATOMICS"])

    # Pick up VULKAN_SDK headers on Windows + Linux (LunarG ships modern Vulkan headers
    # the system packages may be too old for, e.g. VK_ARM_format_pack added in 1.4.318).
    vulkan_sdk = os.environ.get("VULKAN_SDK")
    if vulkan_sdk and rive_env["platform"] in ["windows", "linux", "android"]:
        # LunarG SDK uses 'Include' on Windows, 'include' on Linux.
        for inc_name in ("Include", "include"):
            inc_dir = os.path.join(vulkan_sdk, inc_name)
            if os.path.isdir(inc_dir):
                if rive_env["platform"] == "android":
                    # Use -isystem so Clang treats these as system headers and suppresses
                    # third-party warnings (e.g. VMA's -Wnullability-completeness).
                    rive_env.Append(CCFLAGS=[
                        "-isystem", inc_dir,
                        "-isystem", os.path.join(inc_dir, "vma"),
                    ])
                else:
                    rive_env.Prepend(CPPPATH=[inc_dir, os.path.join(inc_dir, "vma")])
                break
        for lib_name in ("Lib", "lib"):
            lib_dir = os.path.join(vulkan_sdk, lib_name)
            if os.path.isdir(lib_dir):
                rive_env.Append(LIBPATH=[lib_dir])
                break

    if rive_env["platform"] == "linux":
        # RiveGD loads Vulkan and OpenGL entry points at runtime with dlopen.
        rive_env.Append(LIBS=["dl"])

    if rive_env["platform"] == "windows":
        # D3D12 configuration (Windows only)
        rive_env.Append(CPPDEFINES=["RIVE_D3D12", "D3D12_ENABLED", "RIVE_GODOT_D3D12_EXTERNAL_STATE", "_USE_MATH_DEFINES", "NOMINMAX"])
        rive_env.Append(CXXFLAGS=["/std:c++20", "/bigobj"])
        
        # Link system libraries
        rive_env.Append(LIBS=["d3d12", "dxgi", "d3dcompiler", "opengl32", "dxguid", "uuid"])

        # Prioritize Godot build deps for D3DX12
        local_app_data = os.environ.get("LOCALAPPDATA")
        if local_app_data:
            godot_d3d_deps = os.path.join(local_app_data, "Godot", "build_deps", "agility_sdk", "build", "native", "include", "d3dx12")
            if os.path.exists(godot_d3d_deps):
                print(f"RIVE: Using Godot D3D deps from {godot_d3d_deps}")
                rive_env.Append(CPPPATH=[godot_d3d_deps])

        # Add support for external DirectX Headers via env var
        dx_headers = os.environ.get("DIRECTX_HEADERS_PATH")
        if dx_headers:
            print(f"RIVE: Using DirectX Headers from {dx_headers}")
            rive_env.Append(CPPPATH=[
                dx_headers,
                os.path.join(dx_headers, "include"),
                os.path.join(dx_headers, "include", "directx"),
                os.path.join(dx_headers, "include", "dxguids")
            ])
        
        # Add support for D3D12MA via env var
        d3d12ma_path = os.environ.get("D3D12MA_PATH")
        if d3d12ma_path:
            print(f"RIVE: Using D3D12MA from {d3d12ma_path}")
            rive_env.Append(CPPPATH=[d3d12ma_path])

# Collect Rive sources
rive_sources = []
dirs_to_scan = [
    os.path.join(rive_dir, 'src'),
    os.path.join(rive_dir, 'renderer', 'src')
]

exclude_dir_names = {'d3d', 'd3d11', 'd3d12', 'vulkan', 'webgpu', 'dawn', 'android', 'ios', 'ore'}
if rive_env["platform"] != "macos":
    exclude_dir_names.add('metal')
else:
    # macOS: explicitly exclude all D3D directories
    exclude_dir_names.update({'d3d', 'd3d11', 'd3d12'})

if rive_env["platform"] in ["windows", "linux", "android"]:
    if 'vulkan' in exclude_dir_names: exclude_dir_names.remove('vulkan')

if rive_env["platform"] == "windows":
    if 'd3d12' in exclude_dir_names: exclude_dir_names.remove('d3d12')
    if 'd3d' in exclude_dir_names: exclude_dir_names.remove('d3d')

for d in dirs_to_scan:
    if not os.path.exists(d): continue
    for root, dirs, files in os.walk(d):
        dirs[:] = [x for x in dirs if x not in exclude_dir_names]
        for f in files:
            if f.endswith('.cpp') or (f.endswith('.mm') and rive_env["platform"] == "macos"):
                # Exclude EGL dependent file on non-Android platforms
                if f == "load_gles_extensions.cpp" and rive_env["platform"] != "android":
                    continue
                
                # Upstream also uses this implementation for desktop ANGLE.
                # Android lacks the desktop GLAD entry points for that path.
                if f == "pls_impl_webgl.cpp" and rive_env["platform"] == "android":
                    continue
                
                rive_sources.append(os.path.join(root, f))




# On macOS exclude D3D12 renderer source(s) that live in the project `src/` directory.
# This prevents compilation of files that include DirectX headers on macOS.
if rive_env["platform"] == "macos":
    def _basename(node):
        try:
            return os.path.basename(str(node))
        except Exception:
            return str(node)

    d3d_excludes = {"rive_renderer_d3d12.cpp", "rive_renderer_d3d12.mm", "rive_renderer_d3d12.c"}
    filtered_sources = []
    for s in rive_sources:
        name = _basename(s)
        if name in d3d_excludes:
            print(f"RIVE: Excluding {name} on macOS")
            continue
        filtered_sources.append(s)
    rive_sources = filtered_sources

# Glad GL loader is only needed on desktop (Windows/Linux/macOS).
# Android uses the NDK's system GLES3 headers directly, loaded via eglGetProcAddress.
if rive_env["platform"] != "android":
    rive_sources.append(os.path.join(rive_dir, "renderer", "glad", "glad_custom.c"))
    rive_sources.append(os.path.join(rive_dir, "renderer", "glad", "src", "gles2.c"))
    rive_sources.append(os.path.join(rive_dir, "renderer", "glad", "src", "egl.c"))

# Follow the source lists from this pinned Rive revision rather than compiling
# dependency aggregators, tests, and removed HarfBuzz subset/graph implementations.
def dependency_build_config(name):
    path = os.path.join(deps_dir, f"premake5_{name}_v2.lua")
    with open(path, "r", encoding="utf-8") as config:
        return config.read()

def dependency_sources(name, directory, extension):
    config = dependency_build_config(name)
    pattern = (
        r"^\s*" + re.escape(name) + r"\s*\.\.\s*'(/[^']+\."
        + re.escape(extension) + r")'\s*,?\s*$"
    )
    sources = list(dict.fromkeys(re.findall(pattern, config, flags=re.MULTILINE)))
    if not sources:
        raise RuntimeError(f"No {name} sources found in the pinned Rive build configuration")
    result = []
    for relative_path in sources:
        if name == "harfbuzz" and "hb-coretext" in relative_path and rive_env["platform"] != "macos":
            continue
        path = os.path.join(directory, relative_path.lstrip("/"))
        if not os.path.isfile(path):
            raise RuntimeError(f"Missing pinned {name} source: {path}")
        result.append(path)
    return result

harfbuzz_config = dependency_build_config("harfbuzz")
harfbuzz_defines_block = re.search(r"\bdefines\s*\(\s*\{(.*?)\}\s*\)", harfbuzz_config, flags=re.DOTALL)
if not harfbuzz_defines_block:
    raise RuntimeError("Could not read the pinned HarfBuzz compile definitions")
harfbuzz_defines = re.findall(r"^\s*'([^']+)'", harfbuzz_defines_block.group(1), flags=re.MULTILINE)
if not harfbuzz_defines:
    raise RuntimeError("The pinned HarfBuzz compile definitions are empty")
rive_env.Append(CPPDEFINES=harfbuzz_defines)
if rive_env["platform"] == "macos":
    rive_env.Append(CPPDEFINES=['HAVE_CORETEXT'])

rive_sources.extend(dependency_sources("harfbuzz", harfbuzz_dir, "cc"))
rive_sources.append(os.path.join(sheenbidi_dir, "Source", "SheenBidi.c"))

# Add Yoga sources
rive_sources.extend(dependency_sources("yoga", yoga_dir, "cpp"))

# Add Miniaudio sources
if rive_env["platform"] == "ios":
    rive_sources.append(os.path.join(miniaudio_dir, "miniaudio.m"))
else:
    rive_sources.append(os.path.join(miniaudio_dir, "miniaudio.c"))

# Add LibPNG sources
libpng_sources = [
    "png.c", "pngerror.c", "pngget.c", "pngmem.c", "pngpread.c", "pngread.c",
    "pngrio.c", "pngrtran.c", "pngrutil.c", "pngset.c", "pngtrans.c", "pngwio.c",
    "pngwrite.c", "pngwtran.c", "pngwutil.c",
    "arm/arm_init.c", "arm/filter_neon_intrinsics.c", "arm/palette_neon_intrinsics.c"
]
for s in libpng_sources:
    rive_sources.append(os.path.join(libpng_dir, s))

# Add ZLib sources
zlib_sources = [
    "adler32.c", "compress.c", "crc32.c", "deflate.c", "gzclose.c", "gzlib.c",
    "gzread.c", "gzwrite.c", "infback.c", "inffast.c", "inftrees.c", "trees.c",
    "uncompr.c", "zutil.c", "inflate.c"
]
for s in zlib_sources:
    rive_sources.append(os.path.join(zlib_dir, s))

# Add LibJPEG sources
libjpeg_sources = [
    "jaricom.c", "jcapimin.c", "jcapistd.c", "jcarith.c", "jccoefct.c", "jccolor.c",
